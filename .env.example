# Copy to .env and fill in. Nothing here is committed - see .gitignore.

# https://aqicn.org/data-platform/token/  (free, arrives by email in a minute)
AQICN_TOKEN=

# https://app.hopsworks.ai -> Account Settings -> API keys
# The key needs featurestore, project and job scopes.
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=

# Where we're forecasting. Lat/lon drive Open-Meteo; the station slug drives AQICN.
CITY_NAME=lahore
CITY_LAT=31.5497
CITY_LON=74.3436
AQICN_STATION=lahore

# Optional: POST alerts here (Slack incoming webhook works as-is)
ALERT_WEBHOOK_URL=
ALERT_AQI_THRESHOLD=200

# Blank = serverless app.hopsworks.ai. Managed clusters show their host on the
# Quick Start page, e.g. eu-west.cloud.hopsworks.ai
HOPSWORKS_HOST=
HOPSWORKS_PORT=443
